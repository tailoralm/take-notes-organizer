# Folder where Telegram bot saves voice notes (.ogg files)
AUDIO_NOTES_FOLDER=./audio

# Folder where voice notes are copied and transcriptions are saved
AUDIO_NOTES_OUTPUT_FOLDER=./transcripts

# Base URL of the Whisper server (OpenAI-compatible API)
WHISPER_URL=http://127.0.0.1:9000

# Optional API key for the Whisper server (leave empty if auth is disabled)
WHISPER_API_KEY=

# Port for the web UI server (default 8080)
PORT=8080

# --- Transcription pipeline options ---

# Language sent on every transcription request (BCP-47 code)
WHISPER_LANGUAGE=pt

# Target length of each transcription chunk in seconds
WHISPER_CHUNK_SECONDS=300

# Overlap between consecutive chunks in seconds (removes word cuts at boundaries)
WHISPER_CHUNK_OVERLAP_SECONDS=1

# Chunk size in seconds used by the temperature retry for flagged chunks
WHISPER_SMALL_CHUNK_SECONDS=120

# Number of retries per chunk after a hallucination loop is flagged
WHISPER_MAX_RETRIES=2

# Sampling temperature for the primary transcription attempts
WHISPER_TEMPERATURE=0

# Sampling temperature used for the smaller-chunk retry
WHISPER_RETRY_TEMPERATURE=0.2

# A chunk is flagged when the same normalized segment text repeats this many times
WHISPER_REPEAT_LIMIT=3

# A chunk is flagged when its gzip compression ratio exceeds this value
WHISPER_COMPRESSION_RATIO=2.4

# Sound level (dB) under which a region counts as silence, e.g. -35
WHISPER_SILENCE_THRESHOLD_DB=-35

# Internal silences longer than this many seconds are trimmed during preprocessing
WHISPER_SILENCE_TRIM_SECONDS=2